{
  "name": "iberry-dev-console",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build",
    "start": "next start --port 3010",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app --max-warnings=0",
    "format:check": "prettier --check 'app/**/*.{ts,tsx,css}' '*.{json,mjs}'",
    "format": "prettier --write 'app/**/*.{ts,tsx,css}' '*.{json,mjs}'"
  },
  "dependencies": {
    "next": "^15.1.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.22",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "eslint": "9.39.4",
    "prettier": "3.6.2",
    "typescript": "^5.7.2"
  }
}
